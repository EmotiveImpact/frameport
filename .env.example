# Local, single-user by default. Never commit real credentials.
FRAMEPORT_DATA=.frameport
FRAMEPORT_HOST=127.0.0.1
FRAMEPORT_PORT=8040
# Set a random secret before binding beyond loopback.
FRAMEPORT_API_KEY=
FRAMEPORT_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
FRAMEPORT_CHROMIUM_PATH=
# Set only for an isolated, trusted local test environment without sandbox support.
FRAMEPORT_UNSANDBOXED_TEST_BROWSER=0
FRAMEPORT_RETENTION_DAYS=7
